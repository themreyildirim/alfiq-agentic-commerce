{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:alfiq:schema:cart:v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "cart.v1"
    },
    "cart_id": {
      "type": "string",
      "minLength": 1
    },
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "state": {
      "enum": [
        "draft",
        "awaiting_approval",
        "approved",
        "needs_reconfirmation",
        "expired",
        "cancelled"
      ]
    },
    "intent_revision": {
      "type": "integer",
      "minimum": 1
    },
    "selected_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "quote_snapshot": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "urn:alfiq:schema:quote-output:v1",
      "type": "object",
      "properties": {
        "currency": {
          "const": "USD"
        },
        "catalog_version": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "policy_version": {
          "type": "string",
          "minLength": 1
        },
        "lines": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "$id": "urn:alfiq:schema:quote-line-output:v1",
            "type": "object",
            "properties": {
              "product_id": {
                "type": "string",
                "minLength": 1
              },
              "quantity": {
                "type": "integer",
                "minimum": 1
              },
              "catalog_price": {
                "type": "string",
                "pattern": "^(?:0\\.(?:0[1-9]|[1-9]\\d)|[1-9]\\d*\\.\\d{2})$"
              },
              "price_max": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^(?:0\\.(?:0[1-9]|[1-9]\\d)|[1-9]\\d*\\.\\d{2})$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "unit_price_used": {
                "type": "string",
                "pattern": "^(?:0\\.(?:0[1-9]|[1-9]\\d)|[1-9]\\d*\\.\\d{2})$"
              },
              "amount_kind": {
                "enum": [
                  "upper_bound",
                  "catalog_price"
                ]
              },
              "gross": {
                "type": "string",
                "pattern": "^(?:0|[1-9]\\d*)\\.\\d{2}$"
              },
              "discount": {
                "type": "string",
                "pattern": "^(?:0|[1-9]\\d*)\\.\\d{2}$"
              },
              "net": {
                "type": "string",
                "pattern": "^(?:0|[1-9]\\d*)\\.\\d{2}$"
              },
              "discount_percent": {
                "type": "string",
                "pattern": "^\\d+(?:\\.\\d+)?$"
              }
            },
            "required": [
              "product_id",
              "quantity",
              "catalog_price",
              "price_max",
              "unit_price_used",
              "amount_kind",
              "gross",
              "discount",
              "net",
              "discount_percent"
            ],
            "additionalProperties": false
          }
        },
        "gross_total": {
          "type": "string",
          "pattern": "^(?:0|[1-9]\\d*)\\.\\d{2}$"
        },
        "discount_total": {
          "type": "string",
          "pattern": "^(?:0|[1-9]\\d*)\\.\\d{2}$"
        },
        "net_total": {
          "type": "string",
          "pattern": "^(?:0|[1-9]\\d*)\\.\\d{2}$"
        },
        "budget": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(?:0|[1-9]\\d*)\\.\\d{2}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "budget_operator": {
          "enum": [
            "lt",
            "lte"
          ]
        },
        "remaining_budget": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(?:0|[1-9]\\d*)\\.\\d{2}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "ship_to": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Z]{2}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "shipping_country_verified": {
          "type": "boolean"
        },
        "pricing_complete": {
          "type": "boolean"
        },
        "quote_ttl_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "total_scope": {
          "const": "product_subtotal"
        }
      },
      "required": [
        "currency",
        "catalog_version",
        "policy_version",
        "lines",
        "gross_total",
        "discount_total",
        "net_total",
        "budget",
        "budget_operator",
        "remaining_budget",
        "ship_to",
        "shipping_country_verified",
        "pricing_complete",
        "quote_ttl_seconds",
        "total_scope"
      ],
      "additionalProperties": false
    },
    "approval": {
      "anyOf": [
        {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "$id": "urn:alfiq:schema:approval:v1",
          "type": "object",
          "properties": {
            "token": {
              "type": "string",
              "minLength": 1
            },
            "cart_version": {
              "type": "integer",
              "minimum": 1
            },
            "catalog_version": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "policy_version": {
              "type": "string",
              "minLength": 1
            },
            "policy_hash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "issued_at": {
              "type": "string",
              "minLength": 1
            },
            "expires_at": {
              "type": "string",
              "minLength": 1
            },
            "source": {
              "const": "human"
            },
            "cart_id": {
              "type": "string",
              "minLength": 1
            },
            "products_snapshot": {
              "type": "array",
              "minItems": 1,
              "maxItems": 5,
              "items": {
                "$schema": "https://json-schema.org/draft/2020-12/schema",
                "$id": "urn:alfiq:schema:product:v1",
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "url": {
                    "type": "string",
                    "pattern": "^https://(?:www\\.)?alfiqcopper\\.com/"
                  },
                  "currency": {
                    "const": "USD"
                  },
                  "price": {
                    "type": "string",
                    "pattern": "^(?:0\\.(?:0[1-9]|[1-9]\\d)|[1-9]\\d*\\.\\d{2})$"
                  },
                  "price_max": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^(?:0\\.(?:0[1-9]|[1-9]\\d)|[1-9]\\d*\\.\\d{2})$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "stock_status": {
                    "enum": [
                      "in_stock",
                      "out_of_stock",
                      "unknown"
                    ]
                  },
                  "category": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "rating": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^(?:[1-4](?:\\.\\d+)?|5(?:\\.0+)?)$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "review_count": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 0
                  },
                  "price_max_present": {
                    "type": "boolean"
                  },
                  "pricing_mode": {
                    "enum": [
                      "range",
                      "single_observed_price"
                    ]
                  }
                },
                "required": [
                  "id",
                  "name",
                  "url",
                  "currency",
                  "price",
                  "price_max",
                  "stock_status",
                  "category",
                  "rating",
                  "review_count",
                  "price_max_present",
                  "pricing_mode"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "token",
            "cart_version",
            "catalog_version",
            "policy_version",
            "policy_hash",
            "issued_at",
            "expires_at",
            "source",
            "cart_id",
            "products_snapshot"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "order_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "updated_at": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema_version",
    "cart_id",
    "session_id",
    "version",
    "state",
    "intent_revision",
    "selected_ids",
    "quote_snapshot",
    "approval",
    "order_id",
    "created_at",
    "updated_at"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "const": "approved"
          }
        }
      },
      "then": {
        "properties": {
          "order_id": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "else": {
        "properties": {
          "order_id": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "awaiting_approval"
          }
        }
      },
      "then": {
        "properties": {
          "approval": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "$id": "urn:alfiq:schema:approval:v1",
            "type": "object",
            "properties": {
              "token": {
                "type": "string",
                "minLength": 1
              },
              "cart_version": {
                "type": "integer",
                "minimum": 1
              },
              "catalog_version": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "policy_version": {
                "type": "string",
                "minLength": 1
              },
              "policy_hash": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "issued_at": {
                "type": "string",
                "minLength": 1
              },
              "expires_at": {
                "type": "string",
                "minLength": 1
              },
              "source": {
                "const": "human"
              },
              "cart_id": {
                "type": "string",
                "minLength": 1
              },
              "products_snapshot": {
                "type": "array",
                "minItems": 1,
                "maxItems": 5,
                "items": {
                  "$schema": "https://json-schema.org/draft/2020-12/schema",
                  "$id": "urn:alfiq:schema:product:v1",
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "name": {
                      "type": "string",
                      "minLength": 1
                    },
                    "url": {
                      "type": "string",
                      "pattern": "^https://(?:www\\.)?alfiqcopper\\.com/"
                    },
                    "currency": {
                      "const": "USD"
                    },
                    "price": {
                      "type": "string",
                      "pattern": "^(?:0\\.(?:0[1-9]|[1-9]\\d)|[1-9]\\d*\\.\\d{2})$"
                    },
                    "price_max": {
                      "anyOf": [
                        {
                          "type": "string",
                          "pattern": "^(?:0\\.(?:0[1-9]|[1-9]\\d)|[1-9]\\d*\\.\\d{2})$"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "stock_status": {
                      "enum": [
                        "in_stock",
                        "out_of_stock",
                        "unknown"
                      ]
                    },
                    "category": {
                      "anyOf": [
                        {
                          "type": "string",
                          "minLength": 1
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "rating": {
                      "anyOf": [
                        {
                          "type": "string",
                          "pattern": "^(?:[1-4](?:\\.\\d+)?|5(?:\\.0+)?)$"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "review_count": {
                      "type": [
                        "integer",
                        "null"
                      ],
                      "minimum": 0
                    },
                    "price_max_present": {
                      "type": "boolean"
                    },
                    "pricing_mode": {
                      "enum": [
                        "range",
                        "single_observed_price"
                      ]
                    }
                  },
                  "required": [
                    "id",
                    "name",
                    "url",
                    "currency",
                    "price",
                    "price_max",
                    "stock_status",
                    "category",
                    "rating",
                    "review_count",
                    "price_max_present",
                    "pricing_mode"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "token",
              "cart_version",
              "catalog_version",
              "policy_version",
              "policy_hash",
              "issued_at",
              "expires_at",
              "source",
              "cart_id",
              "products_snapshot"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "enum": [
              "draft",
              "cancelled",
              "expired",
              "needs_reconfirmation"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "approval": {
            "type": "null"
          }
        }
      }
    }
  ]
}