{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:alfiq:schema:create_cart_draft-output:v1",
  "oneOf": [
    {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "urn:alfiq:schema:create_cart_draft-success:v1",
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "tool-result.v1"
        },
        "catalog_version": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "policy_version": {
          "type": "string",
          "minLength": 1
        },
        "ok": {
          "const": true
        },
        "cart": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "$id": "urn:alfiq:schema:cart:v1",
          "type": "object",
          "properties": {
            "schema_version": {
              "const": "cart.v1"
            },
            "cart_id": {
              "type": "string",
              "minLength": 1
            },
            "session_id": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "integer",
              "minimum": 1
            },
            "state": {
              "enum": [
                "draft",
                "awaiting_approval",
                "approved",
                "needs_reconfirmation",
                "expired",
                "cancelled"
              ]
            },
            "intent_revision": {
              "type": "integer",
              "minimum": 1
            },
            "selected_ids": {
              "type": "array",
              "minItems": 1,
              "maxItems": 5,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "quote_snapshot": {
              "$schema": "https://json-schema.org/draft/2020-12/schema",
              "$id": "urn:alfiq:schema:quote-output:v1",
              "type": "object",
              "properties": {
                "currency": {
                  "const": "USD"
                },
                "catalog_version": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "policy_version": {
                  "type": "string",
                  "minLength": 1
                },
                "lines": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "$schema": "https://json-schema.org/draft/2020-12/schema",
                    "$id": "urn:alfiq:schema:quote-line-output:v1",
                    "type": "object",
                    "properties": {
                      "product_id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "quantity": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "catalog_price": {
                        "type": "string",
                        "pattern": "^(?:0\\.(?:0[1-9]|[1-9]\\d)|[1-9]\\d*\\.\\d{2})$"
                      },
                      "price_max": {
                        "anyOf": [
                          {
                            "type": "string",
                            "pattern": "^(?:0\\.(?:0[1-9]|[1-9]\\d)|[1-9]\\d*\\.\\d{2})$"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "unit_price_used": {
                        "type": "string",
                        "pattern": "^(?:0\\.(?:0[1-9]|[1-9]\\d)|[1-9]\\d*\\.\\d{2})$"
                      },
                      "amount_kind": {
                        "enum": [
                          "upper_bound",
                          "catalog_price"
                        ]
                      },
                      "gross": {
                        "type": "string",
                        "pattern": "^(?:0|[1-9]\\d*)\\.\\d{2}$"
                      },
                      "discount": {
                        "type": "string",
                        "pattern": "^(?:0|[1-9]\\d*)\\.\\d{2}$"
                      },
                      "net": {
                        "type": "string",
                        "pattern": "^(?:0|[1-9]\\d*)\\.\\d{2}$"
                      },
                      "discount_percent": {
                        "type": "string",
                        "pattern": "^\\d+(?:\\.\\d+)?$"
                      }
                    },
                    "required": [
                      "product_id",
                      "quantity",
                      "catalog_price",
                      "price_max",
                      "unit_price_used",
                      "amount_kind",
                      "gross",
                      "discount",
                      "net",
                      "discount_percent"
                    ],
                    "additionalProperties": false
                  }
                },
                "gross_total": {
                  "type": "string",
                  "pattern": "^(?:0|[1-9]\\d*)\\.\\d{2}$"
                },
                "discount_total": {
                  "type": "string",
                  "pattern": "^(?:0|[1-9]\\d*)\\.\\d{2}$"
                },
                "net_total": {
                  "type": "string",
                  "pattern": "^(?:0|[1-9]\\d*)\\.\\d{2}$"
                },
                "budget": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^(?:0|[1-9]\\d*)\\.\\d{2}$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "budget_operator": {
                  "enum": [
                    "lt",
                    "lte"
                  ]
                },
                "remaining_budget": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^(?:0|[1-9]\\d*)\\.\\d{2}$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "ship_to": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^[A-Z]{2}$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "shipping_country_verified": {
                  "type": "boolean"
                },
                "pricing_complete": {
                  "type": "boolean"
                },
                "quote_ttl_seconds": {
                  "type": "integer",
                  "minimum": 1
                },
                "total_scope": {
                  "const": "product_subtotal"
                }
              },
              "required": [
                "currency",
                "catalog_version",
                "policy_version",
                "lines",
                "gross_total",
                "discount_total",
                "net_total",
                "budget",
                "budget_operator",
                "remaining_budget",
                "ship_to",
                "shipping_country_verified",
                "pricing_complete",
                "quote_ttl_seconds",
                "total_scope"
              ],
              "additionalProperties": false
            },
            "approval": {
              "anyOf": [
                {
                  "$schema": "https://json-schema.org/draft/2020-12/schema",
                  "$id": "urn:alfiq:schema:approval:v1",
                  "type": "object",
                  "properties": {
                    "token": {
                      "type": "string",
                      "minLength": 1
                    },
                    "cart_version": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "catalog_version": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "policy_version": {
                      "type": "string",
                      "minLength": 1
                    },
                    "policy_hash": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "issued_at": {
                      "type": "string",
                      "minLength": 1
                    },
                    "expires_at": {
                      "type": "string",
                      "minLength": 1
                    },
                    "source": {
                      "const": "human"
                    }
                  },
                  "required": [
                    "token",
                    "cart_version",
                    "catalog_version",
                    "policy_version",
                    "policy_hash",
                    "issued_at",
                    "expires_at",
                    "source"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            },
            "order_id": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "created_at": {
              "type": "string",
              "minLength": 1
            },
            "updated_at": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "schema_version",
            "cart_id",
            "session_id",
            "version",
            "state",
            "intent_revision",
            "selected_ids",
            "quote_snapshot",
            "approval",
            "order_id",
            "created_at",
            "updated_at"
          ],
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "state": {
                    "const": "approved"
                  }
                }
              },
              "then": {
                "properties": {
                  "order_id": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "else": {
                "properties": {
                  "order_id": {
                    "type": "null"
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "state": {
                    "const": "awaiting_approval"
                  }
                }
              },
              "then": {
                "properties": {
                  "approval": {
                    "$schema": "https://json-schema.org/draft/2020-12/schema",
                    "$id": "urn:alfiq:schema:approval:v1",
                    "type": "object",
                    "properties": {
                      "token": {
                        "type": "string",
                        "minLength": 1
                      },
                      "cart_version": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "catalog_version": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{64}$"
                      },
                      "policy_version": {
                        "type": "string",
                        "minLength": 1
                      },
                      "policy_hash": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{64}$"
                      },
                      "issued_at": {
                        "type": "string",
                        "minLength": 1
                      },
                      "expires_at": {
                        "type": "string",
                        "minLength": 1
                      },
                      "source": {
                        "const": "human"
                      }
                    },
                    "required": [
                      "token",
                      "cart_version",
                      "catalog_version",
                      "policy_version",
                      "policy_hash",
                      "issued_at",
                      "expires_at",
                      "source"
                    ],
                    "additionalProperties": false
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "state": {
                    "enum": [
                      "draft",
                      "cancelled",
                      "expired",
                      "needs_reconfirmation"
                    ]
                  }
                }
              },
              "then": {
                "properties": {
                  "approval": {
                    "type": "null"
                  }
                }
              }
            }
          ]
        },
        "changed_fields": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "persistence": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "$id": "urn:alfiq:schema:persistence:v1",
          "type": "object",
          "properties": {
            "local_saved": {
              "type": "boolean"
            },
            "drive_backup_saved": {
              "type": "boolean"
            },
            "backup_error": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "local_saved",
            "drive_backup_saved",
            "backup_error"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schema_version",
        "catalog_version",
        "policy_version",
        "ok",
        "cart",
        "changed_fields",
        "persistence"
      ],
      "additionalProperties": false
    },
    {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "urn:alfiq:schema:create_cart_draft-failure:v1",
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "tool-result.v1"
        },
        "catalog_version": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "policy_version": {
          "type": "string",
          "minLength": 1
        },
        "ok": {
          "const": false
        },
        "error": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "$id": "urn:alfiq:schema:tool-error:v1",
          "type": "object",
          "properties": {
            "code": {
              "enum": [
                "INVALID_ARGUMENT",
                "UNKNOWN_TOOL",
                "PRODUCT_NOT_FOUND",
                "POLICY_VIOLATION",
                "OUT_OF_STOCK",
                "STOCK_UNKNOWN",
                "PRODUCT_DATA_INCOMPLETE",
                "DISCOUNT_DEFINITION_MISSING",
                "BUDGET_EXCEEDED",
                "CATALOG_VERSION_CHANGED",
                "CONTEXT_PRODUCT_LIMIT",
                "OUTPUT_VALIDATION_FAILED",
                "SEARCH_LIMIT_EXCEEDED",
                "SESSION_MISMATCH",
                "SESSION_NOT_FOUND",
                "CART_NOT_FOUND",
                "CART_ALREADY_EXISTS",
                "VERSION_CONFLICT",
                "INVALID_STATE_TRANSITION",
                "NO_PENDING_INTENT",
                "INTENT_NOT_READY",
                "CONSTRAINT_VIOLATION"
              ]
            },
            "rule": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "details": {
              "type": "object"
            }
          },
          "required": [
            "code",
            "rule",
            "details"
          ],
          "additionalProperties": false
        },
        "proposed_intent": {
          "anyOf": [
            {
              "$schema": "https://json-schema.org/draft/2020-12/schema",
              "$id": "urn:alfiq:schema:intent:v1",
              "type": "object",
              "properties": {
                "schema_version": {
                  "const": "intent.v1"
                },
                "revision": {
                  "type": "integer",
                  "minimum": 1
                },
                "action": {
                  "enum": [
                    "recommend",
                    "add_to_cart",
                    "update_cart",
                    "request_approval",
                    "confirm_cart",
                    "cancel_cart",
                    "out_of_scope"
                  ]
                },
                "response_language": {
                  "enum": [
                    "tr",
                    "en"
                  ]
                },
                "currency": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^[A-Z]{3}$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "budget": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^(?:0|[1-9]\\d*)\\.\\d{2}$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "budget_operator": {
                  "enum": [
                    "lt",
                    "lte"
                  ]
                },
                "ship_to": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^[A-Z]{2}$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "stock_requirement": {
                  "enum": [
                    "in_stock",
                    "any",
                    "out_of_stock"
                  ]
                },
                "groups": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 5,
                  "items": {
                    "$schema": "https://json-schema.org/draft/2020-12/schema",
                    "$id": "urn:alfiq:schema:candidate-group-input:v1",
                    "type": "object",
                    "properties": {
                      "query": {
                        "type": "string",
                        "maxLength": 200
                      },
                      "category": {
                        "anyOf": [
                          {
                            "type": "string",
                            "minLength": 1
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "min_rating": {
                        "anyOf": [
                          {
                            "type": "string",
                            "pattern": "^(?:[1-4](?:\\.\\d+)?|5(?:\\.0+)?)$"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "min_review_count": {
                        "anyOf": [
                          {
                            "type": "integer",
                            "minimum": 0
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "max_unit_price": {
                        "anyOf": [
                          {
                            "type": "string",
                            "pattern": "^(?:0|[1-9]\\d*)\\.\\d{2}$"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "quantity": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "product_ids": {
                        "type": "array",
                        "minItems": 1,
                        "maxItems": 40,
                        "uniqueItems": true,
                        "items": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    },
                    "required": [
                      "quantity"
                    ],
                    "additionalProperties": false
                  }
                },
                "distinct_products": {
                  "type": "boolean"
                },
                "sort_by": {
                  "enum": [
                    "price_asc",
                    "rating_confidence",
                    "id"
                  ]
                },
                "purpose": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "soft_preferences": {
                  "type": "array",
                  "maxItems": 10,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required_features": {
                  "type": "array",
                  "maxItems": 10,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "clarification_questions": {
                  "type": "array",
                  "maxItems": 5,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "assumptions": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "enum": [
                      "CURRENCY_DEFAULT_USD",
                      "BUDGET_APPLIES_TO_PRODUCT_SUBTOTAL",
                      "BUDGET_OPERATOR_DEFAULT_LTE",
                      "DISTINCT_PRODUCTS_DEFAULT_TRUE"
                    ]
                  }
                }
              },
              "required": [
                "schema_version",
                "revision",
                "action",
                "response_language",
                "currency",
                "budget",
                "budget_operator",
                "ship_to",
                "stock_requirement",
                "groups",
                "distinct_products",
                "sort_by",
                "purpose",
                "soft_preferences",
                "required_features",
                "clarification_questions",
                "assumptions"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "persistence": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "$id": "urn:alfiq:schema:persistence:v1",
          "type": "object",
          "properties": {
            "local_saved": {
              "type": "boolean"
            },
            "drive_backup_saved": {
              "type": "boolean"
            },
            "backup_error": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "local_saved",
            "drive_backup_saved",
            "backup_error"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schema_version",
        "catalog_version",
        "policy_version",
        "ok",
        "error",
        "proposed_intent",
        "persistence"
      ],
      "additionalProperties": false
    }
  ]
}