{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:alfiq:schema:intent-extraction:v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "intent-extraction.v1"
    },
    "patch": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "urn:alfiq:schema:intent-patch:v1",
      "type": "object",
      "properties": {
        "set": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "$id": "urn:alfiq:schema:intent-fields-patch:v1",
          "type": "object",
          "properties": {
            "action": {
              "enum": [
                "recommend",
                "add_to_cart",
                "update_cart",
                "request_approval",
                "confirm_cart",
                "cancel_cart",
                "out_of_scope"
              ]
            },
            "response_language": {
              "enum": [
                "tr",
                "en"
              ]
            },
            "currency": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[A-Z]{3}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "budget": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^(?:0|[1-9]\\d*)\\.\\d{2}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "budget_operator": {
              "enum": [
                "lt",
                "lte"
              ]
            },
            "ship_to": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[A-Z]{2}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "stock_requirement": {
              "enum": [
                "in_stock",
                "any",
                "out_of_stock"
              ]
            },
            "groups": {
              "type": "array",
              "minItems": 1,
              "maxItems": 5,
              "items": {
                "$schema": "https://json-schema.org/draft/2020-12/schema",
                "$id": "urn:alfiq:schema:candidate-group-input:v1",
                "type": "object",
                "properties": {
                  "query": {
                    "type": "string",
                    "maxLength": 200
                  },
                  "category": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "min_rating": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^(?:[1-4](?:\\.\\d+)?|5(?:\\.0+)?)$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "min_review_count": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 0
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "max_unit_price": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^(?:0|[1-9]\\d*)\\.\\d{2}$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "quantity": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "product_ids": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 40,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                "required": [
                  "quantity"
                ],
                "additionalProperties": false
              }
            },
            "distinct_products": {
              "type": "boolean"
            },
            "sort_by": {
              "enum": [
                "price_asc",
                "rating_confidence",
                "id"
              ]
            },
            "purpose": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "soft_preferences": {
              "type": "array",
              "maxItems": 10,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "required_features": {
              "type": "array",
              "maxItems": 10,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "clarification_questions": {
              "type": "array",
              "maxItems": 5,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "group_updates": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "items": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "$id": "urn:alfiq:schema:intent-group-update:v1",
            "type": "object",
            "properties": {
              "group_index": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4
              },
              "set": {
                "$schema": "https://json-schema.org/draft/2020-12/schema",
                "$id": "urn:alfiq:schema:intent-group-patch:v1",
                "type": "object",
                "properties": {
                  "query": {
                    "anyOf": [
                      {
                        "type": "string",
                        "maxLength": 200
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "category": {
                    "anyOf": [
                      {
                        "anyOf": [
                          {
                            "type": "string",
                            "minLength": 1
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "min_rating": {
                    "anyOf": [
                      {
                        "anyOf": [
                          {
                            "type": "string",
                            "pattern": "^(?:[1-4](?:\\.\\d+)?|5(?:\\.0+)?)$"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "min_review_count": {
                    "anyOf": [
                      {
                        "anyOf": [
                          {
                            "type": "integer",
                            "minimum": 0
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "max_unit_price": {
                    "anyOf": [
                      {
                        "anyOf": [
                          {
                            "type": "string",
                            "pattern": "^(?:0|[1-9]\\d*)\\.\\d{2}$"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "quantity": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "product_ids": {
                    "anyOf": [
                      {
                        "type": "array",
                        "minItems": 1,
                        "maxItems": 40,
                        "uniqueItems": true,
                        "items": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [],
                "additionalProperties": false
              }
            },
            "required": [
              "group_index",
              "set"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "evidence": {
      "type": "array",
      "maxItems": 60,
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "urn:alfiq:schema:intent-evidence:v1",
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "quote": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        },
        "required": [
          "path",
          "quote"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "patch",
    "evidence"
  ],
  "additionalProperties": false
}