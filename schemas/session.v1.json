{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:alfiq:schema:session:v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "session.v1"
    },
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "turn": {
      "type": "integer",
      "minimum": 0
    },
    "active_cart_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "intent": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "urn:alfiq:schema:intent:v1",
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "intent.v1"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "action": {
          "enum": [
            "recommend",
            "add_to_cart",
            "update_cart",
            "request_approval",
            "confirm_cart",
            "cancel_cart",
            "out_of_scope"
          ]
        },
        "response_language": {
          "enum": [
            "tr",
            "en"
          ]
        },
        "currency": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Z]{3}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "budget": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(?:0|[1-9]\\d*)\\.\\d{2}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "budget_operator": {
          "enum": [
            "lt",
            "lte"
          ]
        },
        "ship_to": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Z]{2}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "stock_requirement": {
          "enum": [
            "in_stock",
            "any",
            "out_of_stock"
          ]
        },
        "groups": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "items": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "$id": "urn:alfiq:schema:candidate-group-input:v1",
            "type": "object",
            "properties": {
              "query": {
                "type": "string",
                "maxLength": 200
              },
              "category": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "min_rating": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^(?:[1-4](?:\\.\\d+)?|5(?:\\.0+)?)$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "min_review_count": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "max_unit_price": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^(?:0|[1-9]\\d*)\\.\\d{2}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "quantity": {
                "type": "integer",
                "minimum": 1
              },
              "product_ids": {
                "type": "array",
                "minItems": 1,
                "maxItems": 40,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "quantity"
            ],
            "additionalProperties": false
          }
        },
        "distinct_products": {
          "type": "boolean"
        },
        "sort_by": {
          "enum": [
            "price_asc",
            "rating_confidence",
            "id"
          ]
        },
        "purpose": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "soft_preferences": {
          "type": "array",
          "maxItems": 10,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "required_features": {
          "type": "array",
          "maxItems": 10,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "clarification_questions": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "assumptions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "CURRENCY_DEFAULT_USD",
              "BUDGET_APPLIES_TO_PRODUCT_SUBTOTAL",
              "BUDGET_OPERATOR_DEFAULT_LTE",
              "DISTINCT_PRODUCTS_DEFAULT_TRUE"
            ]
          }
        }
      },
      "required": [
        "schema_version",
        "revision",
        "action",
        "response_language",
        "currency",
        "budget",
        "budget_operator",
        "ship_to",
        "stock_requirement",
        "groups",
        "distinct_products",
        "sort_by",
        "purpose",
        "soft_preferences",
        "required_features",
        "clarification_questions",
        "assumptions"
      ],
      "additionalProperties": false
    },
    "pending_intent": {
      "anyOf": [
        {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "$id": "urn:alfiq:schema:intent:v1",
          "type": "object",
          "properties": {
            "schema_version": {
              "const": "intent.v1"
            },
            "revision": {
              "type": "integer",
              "minimum": 1
            },
            "action": {
              "enum": [
                "recommend",
                "add_to_cart",
                "update_cart",
                "request_approval",
                "confirm_cart",
                "cancel_cart",
                "out_of_scope"
              ]
            },
            "response_language": {
              "enum": [
                "tr",
                "en"
              ]
            },
            "currency": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[A-Z]{3}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "budget": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^(?:0|[1-9]\\d*)\\.\\d{2}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "budget_operator": {
              "enum": [
                "lt",
                "lte"
              ]
            },
            "ship_to": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[A-Z]{2}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "stock_requirement": {
              "enum": [
                "in_stock",
                "any",
                "out_of_stock"
              ]
            },
            "groups": {
              "type": "array",
              "minItems": 1,
              "maxItems": 5,
              "items": {
                "$schema": "https://json-schema.org/draft/2020-12/schema",
                "$id": "urn:alfiq:schema:candidate-group-input:v1",
                "type": "object",
                "properties": {
                  "query": {
                    "type": "string",
                    "maxLength": 200
                  },
                  "category": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "min_rating": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^(?:[1-4](?:\\.\\d+)?|5(?:\\.0+)?)$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "min_review_count": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 0
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "max_unit_price": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^(?:0|[1-9]\\d*)\\.\\d{2}$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "quantity": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "product_ids": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 40,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                "required": [
                  "quantity"
                ],
                "additionalProperties": false
              }
            },
            "distinct_products": {
              "type": "boolean"
            },
            "sort_by": {
              "enum": [
                "price_asc",
                "rating_confidence",
                "id"
              ]
            },
            "purpose": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "soft_preferences": {
              "type": "array",
              "maxItems": 10,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "required_features": {
              "type": "array",
              "maxItems": 10,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "clarification_questions": {
              "type": "array",
              "maxItems": 5,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "assumptions": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "enum": [
                  "CURRENCY_DEFAULT_USD",
                  "BUDGET_APPLIES_TO_PRODUCT_SUBTOTAL",
                  "BUDGET_OPERATOR_DEFAULT_LTE",
                  "DISTINCT_PRODUCTS_DEFAULT_TRUE"
                ]
              }
            }
          },
          "required": [
            "schema_version",
            "revision",
            "action",
            "response_language",
            "currency",
            "budget",
            "budget_operator",
            "ship_to",
            "stock_requirement",
            "groups",
            "distinct_products",
            "sort_by",
            "purpose",
            "soft_preferences",
            "required_features",
            "clarification_questions",
            "assumptions"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "last_validation": {
      "anyOf": [
        {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "$id": "urn:alfiq:schema:session-validation:v1",
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "catalog_version": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "policy_version": {
              "type": "string",
              "minLength": 1
            },
            "error": {
              "anyOf": [
                {
                  "$schema": "https://json-schema.org/draft/2020-12/schema",
                  "$id": "urn:alfiq:schema:tool-error:v1",
                  "type": "object",
                  "properties": {
                    "code": {
                      "enum": [
                        "INVALID_ARGUMENT",
                        "UNKNOWN_TOOL",
                        "PRODUCT_NOT_FOUND",
                        "POLICY_VIOLATION",
                        "OUT_OF_STOCK",
                        "STOCK_UNKNOWN",
                        "PRODUCT_DATA_INCOMPLETE",
                        "DISCOUNT_DEFINITION_MISSING",
                        "BUDGET_EXCEEDED",
                        "CATALOG_VERSION_CHANGED",
                        "CONTEXT_PRODUCT_LIMIT",
                        "OUTPUT_VALIDATION_FAILED",
                        "SEARCH_LIMIT_EXCEEDED",
                        "SESSION_MISMATCH",
                        "SESSION_NOT_FOUND",
                        "CART_NOT_FOUND",
                        "CART_ALREADY_EXISTS",
                        "VERSION_CONFLICT",
                        "INVALID_STATE_TRANSITION",
                        "NO_PENDING_INTENT",
                        "INTENT_NOT_READY",
                        "CONSTRAINT_VIOLATION"
                      ]
                    },
                    "rule": {
                      "anyOf": [
                        {
                          "type": "string",
                          "minLength": 1
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "details": {
                      "type": "object"
                    }
                  },
                  "required": [
                    "code",
                    "rule",
                    "details"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "ok",
            "catalog_version",
            "policy_version",
            "error"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "updated_at": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema_version",
    "session_id",
    "turn",
    "active_cart_id",
    "intent",
    "pending_intent",
    "last_validation",
    "created_at",
    "updated_at"
  ],
  "additionalProperties": false
}